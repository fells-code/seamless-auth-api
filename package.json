{
  "name": "seamless-auth-api",
  "version": "0.7.4",
  "description": "Seamless Auth API - A web application server for supporting a Seamless Auth server instance.",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "dev:container": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && npm run build:copy-cjs",
    "build:copy-cjs": "mkdir -p dist/config && cp src/config/*.cjs dist/config/",
    "generate:api": "tsx src/scripts/generateApiTypes.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:badge": "node ./src/scripts/updateCoverageBadge.mjs",
    "test:ci": "CI=true vitest",
    "test:e2e": "CI=false vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "check:changeset-bump": "node ./src/scripts/checkChangesetBump.mjs",
    "version-packages": "changeset version",
    "db:create": "env-cmd -f .env sequelize-cli db:create || sequelize-cli db:create",
    "db:drop": "env-cmd -f .env sequelize-cli db:drop || sequelize-cli db:drop",
    "db:refresh": "env-cmd -f .env sequelize-cli db:drop && sequelize-cli db:create",
    "migrate:create": "env-cmd -f .env sequelize-cli migration:generate --name",
    "migrate:up": "env-cmd -f .env sequelize-cli db:migrate || sequelize-cli db:migrate",
    "migrate:down": "env-cmd -f .env sequelize-cli db:migrate:undo",
    "migrate:reset": "env-cmd -f .env sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fells-code/seamless-auth-api.git"
  },
  "author": "Fells Code LLC",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/fells-code/seamless-auth-api/issues"
  },
  "homepage": "https://github.com/fells-code/seamless-auth-api#readme",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@seamless-auth/messaging": "^0.1.0",
    "@seamless-auth/messaging-aws": "^0.1.0",
    "@seamless-auth/messaging-twilio": "^0.1.0",
    "@seamless-auth/types": "^0.17.0",
    "@simplewebauthn/server": "^13.3.3",
    "base64url": "^3.0.1",
    "bcrypt-ts": "^7.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^3.1.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.12",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "winston": "^3.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.24",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "env-cmd": "^11.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-license-header": "^0.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "sqlite3": "^6.0.1",
    "supertest": "^7.1.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.3"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sqlite3@6.0.1": true
  }
}
